[Unit]
Description=Caddy NaiveProxy & Telegram Web Proxy Bot
After=network.target network-online.target caddy.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=proxy-bot
Group=proxy-bot
WorkingDirectory=/opt/proxy-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/proxy-bot/.env
ExecStart=/opt/proxy-bot/venv/bin/python3 -u /opt/proxy-bot/bot.py

Restart=always
RestartSec=5s

# Security Hardening & Sandboxing
# Note: Directives that implicitly enforce kernel PR_SET_NO_NEW_PRIVS in systemd.exec
# (e.g., PrivateDevices, ProtectKernelTunables, ProtectKernelModules, RestrictAddressFamilies)
# must remain omitted so setuid sudo can invoke /usr/local/bin/caddy-control via /etc/sudoers.d/proxy-bot.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ReadWritePaths=/opt/proxy-bot /tmp /etc/caddy

[Install]
WantedBy=multi-user.target
